# Production: set both Supabase values. The demo banner and sample data never appear.
# Preview/demo sites: leave them empty and set VITE_DEMO_MODE=true (or run `npm run build:demo`).
# A production build with neither shows a "not connected" screen instead of sample listings.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_DEMO_MODE=
